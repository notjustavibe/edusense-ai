#:kivy 2.3.0

<Btn@Button>:
    size_hint_y: None
    height: dp(48)
    bold: True
    background_normal: ''
    background_color: 0.16, 0.45, 0.9, 1

<GhostBtn@Button>:
    size_hint_y: None
    height: dp(48)
    background_normal: ''
    background_color: 0.2, 0.25, 0.35, 1

<Field@TextInput>:
    size_hint_y: None
    height: dp(44)
    multiline: False
    padding: dp(10), dp(12)
    background_color: 0.12, 0.15, 0.22, 1
    foreground_color: 1, 1, 1, 1
    hint_text_color: 0.55, 0.6, 0.7, 1
    cursor_color: 1, 1, 1, 1

<Heading@Label>:
    size_hint_y: None
    height: dp(40)
    font_size: '20sp'
    bold: True
    halign: 'left'
    text_size: self.width, None

<Note@Label>:
    size_hint_y: None
    height: max(dp(28), self.texture_size[1])
    font_size: '13sp'
    color: 0.7, 0.78, 0.9, 1
    halign: 'left'
    text_size: self.width, None

ScreenManager:
    HomeScreen:
        name: 'home'
    StudentsScreen:
        name: 'students'
    EnrollScreen:
        name: 'enroll'
    SessionScreen:
        name: 'session'

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(8)
        Heading:
            text: 'EduSense AI  (v0.2.0 - with subjects)'
        Field:
            id: server_in
            hint_text: 'Server URL, e.g. http://192.168.1.10:5000'
        Field:
            id: key_in
            hint_text: 'API key (optional)'
            password: True
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            Btn:
                text: 'Save & test'
                on_release: root.save_and_test()
            GhostBtn:
                text: 'Students'
                on_release: app.root.current = 'students'
        Note:
            id: status
            text: ''
        Spinner:
            id: subject_spin
            text: 'Loading subjects...'
            size_hint_y: None
            height: dp(44)
            background_normal: ''
            background_color: 0.12, 0.15, 0.22, 1
        Field:
            id: title_in
            hint_text: 'New session title, e.g. Week 5'
        Btn:
            text: 'Start attendance session'
            on_release: root.start_session()
        Heading:
            text: 'Recent sessions'
        ScrollView:
            GridLayout:
                id: sessions_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(6)

<StudentsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(8)
        Heading:
            text: 'Students'
        Note:
            id: status
            text: ''
        ScrollView:
            GridLayout:
                id: list_box
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(6)
        Btn:
            text: 'Enroll new student'
            on_release: app.root.current = 'enroll'
        GhostBtn:
            text: 'Back'
            on_release: app.root.current = 'home'

<EnrollScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(8)
        Heading:
            text: 'Enroll student'
        Field:
            id: roll_in
            hint_text: 'Roll number'
        Field:
            id: name_in
            hint_text: 'Full name'
        Note:
            id: count
            text: ''
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            Btn:
                text: 'Take photo'
                on_release: root.add_photo('camera')
            GhostBtn:
                text: 'From gallery'
                on_release: root.add_photo('gallery')
            GhostBtn:
                text: 'Clear'
                on_release: root.clear_photos()
        Btn:
            text: 'Enroll'
            on_release: root.submit()
        Note:
            id: status
            text: ''
        Widget:
        GhostBtn:
            text: 'Back'
            on_release: app.root.current = 'students'

<SessionScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(8)
        Heading:
            id: heading
            text: ''
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            Btn:
                text: 'Take class photo'
                on_release: root.capture('camera')
            GhostBtn:
                text: 'From gallery'
                on_release: root.capture('gallery')
        Note:
            id: result
            text: ''
            height: max(dp(60), self.texture_size[1])
        ScrollView:
            Label:
                id: report
                text: ''
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None
                halign: 'left'
                valign: 'top'
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(8)
            GhostBtn:
                text: 'Refresh'
                on_release: root.refresh()
            GhostBtn:
                text: 'Open CSV'
                on_release: root.open_csv()
            GhostBtn:
                text: 'Done'
                on_release: app.root.current = 'home'
